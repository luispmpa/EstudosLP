                }
              },
              "type": {
                "type": "string",
                "const": "true_false"
              },
              "alternatives": {
                "minItems": 2,
                "maxItems": 2,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "key": {
                      "type": "string",
                      "enum": [
                        "TRUE",
                        "FALSE"
                      ]
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2000000
